        bash)
            cat << 'EOF'
_nene() {
  COMPREPLY=()
  local word="${COMP_WORDS[COMP_CWORD]}"
  local prev="${COMP_WORDS[COMP_CWORD-1]}"

  if [[ "$COMP_CWORD" -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$(nene flags)" -- "$word") )

  elif [[ "$prev" == "-r" ]] || [[ "$prev" == "--remove" ]]; then
    local list_file="$HOME/.local/share/nene/pkg-installed"
    if [[ -f "$list_file" ]]; then
      mapfile -t completions < "$list_file"
      COMPREPLY=( $(compgen -W "${completions[*]}" -- "$word") )
    fi
  elif [[ "$prev" == "-i" ]] || [[ "$prev" == "-iq" ]] || [[ "$prev" == "--install" ]]; then
    local list_file="$HOME/.local/share/nene/update-lists"

    if [[ -f "$list_file" ]]; then
      mapfile -t completions < "$list_file"
      COMPREPLY=( $(compgen -W "${completions[*]}" -- "$word") )
    fi
  fi
}

complete -F _nene nene
EOF
            exit 0
            ;; 
        zsh)
cat << 'EOF'
#compdef nene

# Completion zsh untuk nene.
#   nene <TAB>            -> daftar opsi
#   nene -r <TAB>         -> paket yang terpasang
#   nene -i <TAB>         -> paket yang bisa dipasang
#   nene -m <TAB>         -> 0 / 1
# Paket yang sudah ditulis di baris perintah tidak ditawarkan lagi.

_nene() {
  local data_dir="$HOME/.local/share/nene"
  local opt="${words[2]}"
  local list_file out
  local -a items used

  # Argumen pertama: opsi. Keluaran `nene flags` boleh spasi atau baris baru.
  if (( CURRENT == 2 )); then
    out=$(nene flags 2>/dev/null)
    items=( ${=out} )
    compadd -a items
    return
  fi

  # Argumen berikutnya: bergantung pada opsi pertama.
  case "$opt" in
    -r*|--remove)
      list_file="$data_dir/pkg-installed" ;;
    -i*|--install)
      list_file="$data_dir/update-lists" ;;
    -m|--mode-online)
      (( CURRENT == 3 )) && compadd -- 0 1
      return ;;
    *)
      return ;;
  esac

  [[ -r $list_file ]] || return

  items=( ${(f)"$(< $list_file)"} )
  used=( ${words[3,CURRENT-1]} )          # paket yang sudah diketik
  compadd -F used -a items
}

# Dua cara pakai: di-autoload dari fpath (file bernama _nene),
# atau di-eval langsung: eval "$(nene completion zsh)"
if [[ ${funcstack[1]} == _nene ]]; then
  _nene "$@"
else
  compdef _nene nene
fi
EOF
      break
        ;;
        fish)
            cat << 'EOF'
function __nene_using_position
    set -l cmd (commandline -opc)
    if [ (count $cmd) -eq $argv[1] ]
        return 0
    end
    return 1
end

function __nene_previous_is
    set -l cmd (commandline -opc)
    if [ (count $cmd) -gt 1 ]
        if contains -- $cmd[-1] $argv
            return 0
        end
    end
    return 1
end

# Hapus completion bawaan jika ada, lalu definisikan ulang
complete -c nene -e

# Posisi pertama (Flags utama)
complete -c nene -n '__nene_using_position 2' -a '(nene flags)'

# Completion untuk -r / --remove
complete -c nene -n '__nene_previous_is -r --remove' -a '(cat $HOME/.local/share/nene/pkg-installed 2>/dev/null)'

# Completion untuk -i / -iq / --install
complete -c nene -n '__nene_previous_is -i -iq --install' -a '(cat $HOME/.local/share/nene/update-lists 2>/dev/null)'
EOF
            exit 0
