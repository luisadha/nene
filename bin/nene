offline_status() {
   echo -e "No internet connections";
  return 6
}
error_exit_seconds ()
{
  echo "$DRY_RUN_PROMPT Deb file URL not found in release JSON. Check GitHub repository structure. (code: ${HTTP_STATUS:=404})";
return 1
}

url_regex='^(https?|ftp)://[a-zA-Z0-9.-]+\.[a-zA-Z]{2,}(:[0-9]+)?(/.*)?$'

handle_positional() {
  local arg=$1
  if [[ $arg =~ $url_regex ]]; then
    curl -L "$arg" | bash
    echo ""
    read -r -p "Process completed."
  else
    echo "No valid URL or option provided: $arg" >&2
  fi
}
cluster_has() { [[ $1 == -[!-]* && $1 == *"$2"* ]]; }

if [[ $# -eq 0 ]]; then
default_apps; # deprecreted
#nene --mode-online=0
exit 0
fi

end_opts=0
while [[ $# -gt 0 ]]; do
if (( end_opts )); then
    handle_positional "$1"; shift; continue
fi
 case "$1" in
    flags)
    short_opt
    long_opt
    clustered_opt
    separate_opt
    inline_opt
    break;;
    --completion)
        # Handler untuk --cometions
