    selected_opt=$(printf "%s\n" "-m=" "--mode-online=" | fzf --reverse --header="${PROMPT['optIOIM']}")

    if [ -n "$selected_opt" ]; then
        # Bersihkan spasi di awal opsi yang dipilih
        clean_opt=$(echo "$selected_opt" | awk '{print $1}')

        # Periksa apakah opsi menggunakan format '=' (seperti -m=) atau spasi biasa
        if [[ "$clean_opt" == *= ]]; then
            echo -ne "\t ${PROMPT['optIM']} ${clean_opt} (boolean): " > /dev/tty
            read -r user_args < /dev/tty

            if [ -n "$user_args" ]; then
                nene "${clean_opt}${user_args}"
            else
                nene "${clean_opt}"
            fi
        else
            echo -ne "\t Input argument for ${clean_opt}: " > /dev/tty
            read -r user_args < /dev/tty

            if [ -n "$user_args" ]; then
                nene "$clean_opt" "$user_args"
            else
                nene "$clean_opt"
            fi
        fi
    fi
    break;;
    -Io|--interactive-options)
     #set -xv 
      selected_opt=$(show_help ALL_FLAGZ | sed -n '/Options:/,$p' | grep -E -- '^ *(-i\b|--install\b|-r\b|--remove)' | fzf --reverse --header="${PROMPT['optIOIM']}" )

if [ -n "$selected_opt" ]; then
    clean_opt=$(echo "$selected_opt" | awk '{print $1}')
    
    tmp_parent=$(mktemp -d "$HOME/.local/share/nene/completion_sessions_$$.XXXXXX")

    current_pwd="$PWD"
    trap 'cd "$current_pwd" 2>/dev/null; rm -rf "$tmp_parent"' EXIT INT TERM
    # Buat direktori berdasarkan opsi yang dipilih
    if [ "$clean_opt" = "-i" ] || [ "$clean_opt" = "--install" ]; then
        tmp_dir="$tmp_parent/update-lists-d"
        mkdir -p "$tmp_dir"
        cd "$tmp_dir" || exit
        
        if [ -f "$HOME/.local/share/nene/update-lists" ]; then
            xargs -a "$HOME/.local/share/nene/update-lists" touch
        fi
        
    elif [ "$clean_opt" = "-r" ] || [ "$clean_opt" = "--remove" ]; then
        tmp_dir="$tmp_parent/pkg-installed-d"
        mkdir -p "$tmp_dir"
        cd "$tmp_dir" || exit
        
        # Sesuaikan path file daftar paket terinstal jika berbeda (misal: pkg-installed)
        if [ -f "$HOME/.local/share/nene/pkg-installed" ]; then
            xargs -a "$HOME/.local/share/nene/pkg-installed" touch
        fi
    else
        # Fallback jika opsi lain
        tmp_dir="$tmp_parent/other-d"
        mkdir -p "$tmp_dir"
        cd "$tmp_dir" || exit
    fi  
